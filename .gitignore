# OmniScholar Git Ignore Configuration

# Temporary analysis runs & artifacts
version 1.0.0/app/runs/*
!version 1.0.0/app/runs/.gitkeep

# Python cache & build
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Binaries & external toolkits
tools/
*.exe

# OS specific files
.DS_Store
Thumbs.db
*.tmp
*.log
